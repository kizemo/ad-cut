# ad-cut skill · environment variable template
#
# Copy to ~/.bashrc (or .env) and edit for your machine.
# Source: `source ~/.bashrc` or `set -a; source env.example; set +a`
#
# Quick check after sourcing:
#   echo $ADCUT_PYTHON && $ADCUT_PYTHON -c "import faster_whisper; print(faster_whisper.__version__)"
#
# NOTE: Filename is `env.example` (no leading dot) instead of `.env.example`
# to avoid a write-protection hook pattern that blocks `.env*`. Functionally
# equivalent: `source env.example` works identically.

# =============================================================================
# REQUIRED
# =============================================================================

# Path to the Python that has faster-whisper installed.
# MUST be Python 3.12 (3.14 has no cython wheel, faster-whisper won't install).
# Windows Git Bash:
#   ADCUT_PYTHON="/c/Users/<u>/myvenv/Scripts/python.exe"
# Linux/macOS:
#   ADCUT_PYTHON="$HOME/myvenv/bin/python"
ADCUT_PYTHON=""

# HuggingFace mirror — REQUIRED for users in China (huggingface.co often 502).
# Outside China, you can use the default (https://huggingface.co) by leaving blank.
HF_ENDPOINT="https://hf-mirror.com"

# Disable HuggingFace's XET accelerator (compatibility with mirror).
HF_HUB_DISABLE_XET=1

# =============================================================================
# OPTIONAL · faster-whisper tuning
# =============================================================================

# Model size: small (default, fast) / medium / large-v3 (slow, accurate)
ADCUT_WHISPER_MODEL=small

# Language: zh default / en / auto (auto-detect slower)
ADCUT_WHISPER_LANG=zh

# Device: cpu (default) / cuda (requires NVIDIA GPU + CUDA toolkit)
ADCUT_WHISPER_DEVICE=cpu

# Compute type: int8 (CPU default, smaller) / float16 (CUDA) / float32 (most accurate, slowest)
ADCUT_WHISPER_COMPUTE=int8

# =============================================================================
# OPTIONAL · claude CLI (already configured globally per .bashrc)
# =============================================================================
# These are typically set elsewhere; uncomment if running ad-cut from a clean shell.
#
# ANTHROPIC_BASE_URL="https://api.minimaxi.com"
# ANTHROPIC_AUTH_TOKEN="<your-token>"

# =============================================================================
# Verification (don't change unless debugging)
# =============================================================================

# Skip preflight checks (DANGEROUS, use only for batch/CI)
# ADCUT_SKIP_PREFLIGHT=0

# ffmpeg/ffprobe binaries (auto-detected from PATH; override only if needed)
# FFMPEG_BIN="ffmpeg"
# FFPROBE_BIN="ffprobe"